# === Database ===
DATABASE_URL=postgresql://chatbot_user:chatbot_pass@localhost:5432/chatbot_db

# === Auth ===
JWT_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === LLM Commercial (pilih salah satu, atau isi dua-duanya) ===
GEMINI_API_KEY=isi-api-key-gemini-anda
GROQ_API_KEY=isi-api-key-groq-anda
COMMERCIAL_PROVIDER=gemini
# opsi: gemini | groq

# === LLM On-Premise (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === Vector DB (Chroma - jalan lokal, tidak butuh API key) ===
CHROMA_PERSIST_DIR=./chroma_data

# === Sensitivity Policy ===
# daftar kata kunci sederhana penanda "data sensitif" -> dialihkan ke on-prem
SENSITIVE_KEYWORDS=rahasia,internal,confidential,ktp,npwp
