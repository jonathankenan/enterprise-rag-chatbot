# === Database ===
DATABASE_URL=postgresql://chatbot_user:chatbot_pass@localhost:5433/chatbot_db

# === Auth ===
JWT_SECRET_KEY=ganti-dengan-string-acak-yang-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === LLM Commercial ===
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COMMERCIAL_PROVIDER=groq
# dipakai sebagai default untuk fitur internal (mis. auto-generate judul chat)

# === LLM On-Premise (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === Vector DB (Chroma - jalan lokal, tidak butuh API key) ===
CHROMA_PERSIST_DIR=./chroma_data

# === Sensitivity Policy ===
SENSITIVE_KEYWORDS=rahasia,internal,confidential,ktp,npwp

# === Guardrail: Enkripsi at-rest untuk isi pesan chat (SRS FCR-003 poin 3.k) ===
# WAJIB diisi untuk pemakaian sungguhan — kalau kosong, sistem tetap jalan
# (dev-friendly) tapi pakai key sementara yang hilang tiap restart server,
# artinya pesan lama jadi tidak bisa didekripsi lagi. Generate dengan:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MESSAGE_ENCRYPTION_KEY=

# === Guardrail: batas panjang prompt & rate limiting (SRS Model Usage Policy) ===
# Nilai default di app/config.py sudah masuk akal untuk skala PoC — override
# di sini kalau IT admin perlu konfigurasi ulang (SRS mensyaratkan ini
# "dapat di konfigurasi oleh IT admin").
# MAX_PROMPT_LENGTH_ONPREM=6000
# MAX_PROMPT_LENGTH_COMMERCIAL=3000
# MAX_RESPONSE_TOKENS_COMMERCIAL=1024
# CHAT_RATE_LIMIT_MAX_MESSAGES=30
# CHAT_RATE_LIMIT_WINDOW_SECONDS=60